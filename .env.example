# Copy this file to .env and uncomment the pair for your platform.
# Both are commented out on purpose: an unedited copy makes the sync
# skip every target instead of writing to a bogus path.

# Windows
# CLAUDE_SKILLS="C:\Users\<user>\.claude\skills"
# CODEX_SKILLS="C:\Users\<user>\.codex\skills"

# Linux / macOS (use absolute paths)
# CLAUDE_SKILLS="/home/<user>/.claude/skills"
# CODEX_SKILLS="/home/<user>/.codex/skills"
