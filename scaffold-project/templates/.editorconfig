# editorconfig.org

# top-most EditorConfig file
root = true

# Default settings:
# A newline ending every file
# Use 2 spaces as indentation
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Languages whose own style guides indent with 4 spaces
[*.{py,java,kt,kts,rs,gradle}]
indent_size = 4

# Go and Makefiles indent with tabs
[{*.go,Makefile,*.mk}]
indent_style = tab

# Trailing whitespace is a hard line break in Markdown
[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
