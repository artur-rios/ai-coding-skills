# Line endings are LF in the repository and in the working tree, on every platform, so a file
# checked out on Windows is byte-identical to the one CI builds. Windows-only scripts are the
# exception: cmd.exe needs CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files are never normalized or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
