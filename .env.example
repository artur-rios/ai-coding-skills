# Copy this file to .env and uncomment the lines for your platform.
# They are commented out on purpose: an unedited copy makes the sync skip
# every target instead of writing to a bogus path.
#
# Each target is the user-level skills folder an agent loads skills from:
#   CLAUDE_SKILLS    Claude Code   ~/.claude/skills
#   CODEX_SKILLS     Codex         ~/.agents/skills  (older Codex releases read ~/.codex/skills)
#   OPENCODE_SKILLS  opencode      ~/.config/opencode/skills
#
# opencode also reads ~/.claude/skills and ~/.agents/skills. With all three set,
# it sees each skill more than once and uses the copy in its own folder; they
# are identical, so that is harmless. Leave out any agent you don't use.

# Windows
# CLAUDE_SKILLS="C:\Users\<user>\.claude\skills"
# CODEX_SKILLS="C:\Users\<user>\.agents\skills"
# OPENCODE_SKILLS="C:\Users\<user>\.config\opencode\skills"

# Linux / macOS (use absolute paths)
# CLAUDE_SKILLS="/home/<user>/.claude/skills"
# CODEX_SKILLS="/home/<user>/.agents/skills"
# OPENCODE_SKILLS="/home/<user>/.config/opencode/skills"
